PORT=3000
NODE_ENV=development

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional local-development DNS resolvers for MongoDB Atlas SRV connections.
MONGODB_DNS_SERVERS=

# Uploaded documents are temporary and are deleted after this many hours.
DOCUMENT_RETENTION_HOURS=24

# Generated completed PDFs are temporary and use the same retention period.
# GENERATED_PDF_DIR=

# Gemini document-analysis provider (keep the actual key only in server/.env).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
